# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas M0 Connection String
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/anonymous_qna?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-url>/anonymous_qna?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Free tier for student screenshots/images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
